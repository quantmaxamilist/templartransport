---
import Base from '../../layouts/Base.astro';
import InnerHero from '../../components/InnerHero.astro';
import Icon from '../../components/Icon.astro';
import Testimonials from '../../components/Testimonials.astro';
import Enquiry from '../../components/Enquiry.astro';
import { areas, services, facts, about, site, type Area } from '../../data/site';
export function getStaticPaths() { return areas.map((a) => ({ params: { slug: a.slug }, props: { a } })); }
const { a } = Astro.props as { a: Area };
const near = areas.filter((x) => x.slug !== a.slug);
const title = `Refrigerated Transport ${a.name} | Chilled & Frozen Distribution | Templar Transport`;
const description = `Temperature controlled distribution for ${a.name}, ${a.county} — chilled and frozen goods, van to articulated lorry, one-off jobs or regular contracts. Templar Transport Ltd, established 1980.`;
const isBase = a.slug === 'gillingham';
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: `Temperature controlled distribution — ${a.name}`, serviceType: 'Refrigerated transport', provider: { '@id': `${site.url}/#business` }, areaServed: { '@type': 'Place', name: `${a.name}, ${a.county}` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'Areas', item: `${site.url}/areas` }, { '@type': 'ListItem', position: 3, name: a.name, item: `${site.url}/areas/${a.slug}` }] },
];
---
<Base title={title} description={description} schema={schema}>
  <InnerHero label={`${a.name}, ${a.county}`} title={`Refrigerated transport in ${a.name}`} sub={isBase ? 'Our home town — temperature controlled distribution throughout the UK.' : `Chilled and frozen distribution for ${a.name} and throughout the UK.`} crumbs={[{ href: '/areas', label: 'Areas' }, { href: `/areas/${a.slug}`, label: a.name }]} />
  <section class="section light">
    <div class="container ap">
      <div class="ap__copy">
        <p class="lead" data-reveal>{isBase
          ? `Templar Transport Ltd is based in Gillingham, Dorset. Established since 1980, we provide temperature controlled distribution throughout the UK.`
          : `Templar Transport Ltd provides temperature controlled distribution for businesses in ${a.name}, ${a.county}, and throughout the UK — from our base in Gillingham, Dorset.`}</p>
        <p data-reveal>{about.p1}</p>
        <p class="ap__strong" data-reveal>{about.p2}</p>
      </div>
      <aside class="ap__card navy" data-reveal>
        <p class="label">Quote for {a.name}</p>
        <a class="tel ap__tel" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
        <ul>{facts.map((f) => <li><Icon name="check" />{f}</li>)}</ul>
        <a class="btn btn--white" href="#quote">Get a quote <Icon name="arrow" /></a>
      </aside>
    </div>
  </section>
  <section class="section--tight ice">
    <div class="container">
      <p class="label" data-reveal>Services in {a.name}</p>
      <h2 class="ap__h" data-reveal>Chilled &amp; frozen distribution</h2>
      <ul class="ap__svc">{services.map((s) => <li data-reveal><span>{s.n}</span><h3>{s.h}</h3><p class="muted">{s.p}</p></li>)}</ul>
    </div>
  </section>
  <Testimonials />
  <section class="section--tight light">
    <div class="container"><p class="label">Also covering</p><ul class="chips ap__near">{near.map((n) => <li><a class="chip" href={`/areas/${n.slug}`}>{n.name}</a></li>)}</ul></div>
  </section>
  <Enquiry title={`Get a quote — ${a.name}`} place={a.name} />
</Base>
<style>
  .ap { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 960px) { .ap { grid-template-columns: 1.3fr .7fr; } }
  .ap__copy { display: grid; gap: 1.2rem; }
  .ap__strong { font-family: var(--f-display); font-weight: 700; font-style: italic; font-size: var(--fs-statement); color: var(--navy); line-height: 1.2; }
  .ap__card { border-radius: var(--radius); padding: clamp(1.4rem, 3vw, 2rem); display: grid; gap: 1rem; justify-items: start; }
  .ap__tel { font-size: 1.8rem; }
  .ap__card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .ap__card li { display: flex; gap: .5rem; }
  .ap__card li :global(svg) { width: 18px; height: 18px; color: #ff4a3d; flex-shrink: 0; margin-top: .2rem; }
  .ap__h { margin: .8rem 0 1.8rem; }
  .ap__svc { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .ap__svc li { background: #fff; border-radius: var(--radius); padding: 1.4rem; display: grid; gap: .5rem; align-content: start; }
  .ap__svc span { font-family: var(--f-display); font-weight: 800; font-style: italic; color: var(--red); font-size: 1.8rem; line-height: 1; }
  .ap__near { margin-top: 1rem; }
</style>
