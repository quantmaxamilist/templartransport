---
import Base from '../layouts/Base.astro';
import InnerHero from '../components/InnerHero.astro';
import Gallery from '../components/Gallery.astro';
import Enquiry from '../components/Enquiry.astro';
import { about, facts } from '../data/site';
---
<Base title={about.title} description={about.description}>
  <InnerHero label="About" title="About Templar Transport" sub={facts[1]} crumbs={[{ href: '/about', label: 'About' }]} />
  <section class="section light">
    <div class="container ab">
      <div class="ab__copy">
        <p class="lead" data-reveal>{about.p1}</p>
        <p class="ab__strong" data-reveal>{about.p2}</p>
        <ul class="ab__facts" data-reveal>{facts.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="ph ab__img" data-reveal><img src="/img/fleet-lineup-sm.webp" width="900" height="675" alt="Templar Transport fleet" /></div>
    </div>
  </section>
  <section class="section--tight ice">
    <div class="container">
      <p class="label" data-reveal>Our vehicles</p>
      <h2 class="ab__h" data-reveal>Van to articulated lorry</h2>
      <Gallery items={[
        { src: '/img/fleet-yard.webp', w: 400, h: 267, alt: 'Templar Transport Vehicles' },
        { src: '/img/artic.webp', w: 400, h: 266, alt: 'Templar Transport articulated lorry' },
        { src: '/img/rigid.webp', w: 248, h: 165, alt: 'Templar Transport rigid lorry' },
      ]} />
    </div>
  </section>
  <Enquiry />
</Base>
<style>
  .ab { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 960px) { .ab { grid-template-columns: 1.1fr .9fr; } }
  .ab__copy { display: grid; gap: 1.4rem; }
  .ab__strong { font-family: var(--f-display); font-weight: 700; font-style: italic; font-size: var(--fs-statement); color: var(--navy); line-height: 1.2; }
  .ab__facts { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .ab__facts li { border-left: 3px solid var(--red); padding-left: .9rem; font-weight: 600; }
  .ab__img { aspect-ratio: 4 / 3; }
  .ab__h { margin: .8rem 0 1.8rem; }
</style>
