---
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4.4-2.2 1.4a11 11 0 0 0 7.1 7.1l1.4-2.2 4.4 1.6V19a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 3.4 5.2 1.6 1.6 0 0 1 5 3.5Z" />}
  {name === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'pin' && <><path d="M12 21s-6.5-6.1-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.9 12 21 12 21Z" /><circle cx="12" cy="9.8" r="2.3" /></>}
  {name === 'calendar' && <><rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /></>}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'star' && <path fill="currentColor" stroke="none" d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z" />}
  {name === 'quote' && <path fill="currentColor" stroke="none" d="M4 18v-5.4C4 8.4 6.3 5.7 10 5l.8 1.6C8.6 7.4 7.4 8.9 7.3 11H10v7H4Zm10 0v-5.4c0-4.2 2.3-6.9 6-7.6l.8 1.6c-2.2.8-3.4 2.3-3.5 4.4H20v7h-6Z" />}
  {name === 'van' && <><path d="M2.5 16.5V8a1.5 1.5 0 0 1 1.5-1.5h10.5l4 4.5H20a1.5 1.5 0 0 1 1.5 1.5v4h-2" /><path d="M14.5 6.5V11h4" /><circle cx="7" cy="17" r="2" /><circle cx="17" cy="17" r="2" /><path d="M9 17h6" /></>}
  {name === 'shield' && <><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.3 7.5 9.5 4.4-1.2 7.5-4.9 7.5-9.5V6L12 3Z" /><path d="m9 12 2 2 4-4" /></>}
  {name === 'wrench' && <path d="M14.7 6.3a4 4 0 0 0-5.2 5.2l-6 6a1.5 1.5 0 0 0 2.1 2.1l6-6a4 4 0 0 0 5.2-5.2l-2.5 2.5-2.1-.5-.5-2.1 3-2Z" />}
  {name === 'drop' && <path d="M12 3.5s-6 6.6-6 10.6a6 6 0 0 0 12 0c0-4-6-10.6-6-10.6Z" />}
  {name === 'bolt' && <path d="M13 3 5 13.5h6L10 21l8-10.5h-6L13 3Z" />}
  {name === 'flame' && <path d="M12 21c-3.6 0-6-2.4-6-5.6 0-3.5 3-5.3 3.6-9.4 2.5 1.4 3.6 3.6 3.6 5.6 1-.5 1.7-1.5 1.9-2.6C17 10.6 18 12.9 18 15.4 18 18.6 15.6 21 12 21Z" />}
  {name === 'chassis' && <><circle cx="7" cy="16" r="3" /><circle cx="17" cy="16" r="3" /><path d="M2 12h20M7 12V8h10v4" /></>}
  {name === 'home' && <><path d="M3 11 12 4l9 7" /><path d="M5.5 9.5V20h13V9.5" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'google' && <><path stroke="none" fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3Z"/><path stroke="none" fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.5l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path stroke="none" fill="#FBBC05" d="M6.4 13.9a6 6 0 0 1 0-3.8V7.5H3.1a10 10 0 0 0 0 9Z"/><path stroke="none" fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.5l3.3 2.6C7.2 7.8 9.4 6 12 6Z"/></>}
  {name === 'whatsapp' && <path fill="currentColor" stroke="none" d="M12 2.5a9.4 9.4 0 0 0-8.1 14.2L2.6 21.5l4.9-1.3A9.4 9.4 0 1 0 12 2.5Zm0 17.1c-1.4 0-2.8-.4-4-1.1l-.3-.2-2.9.8.8-2.8-.2-.3a7.7 7.7 0 1 1 6.6 3.6Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.5-.3Z" />}
  {name === 'facebook' && <path fill="currentColor" stroke="none" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z" />}
  {name === 'roof' && <><path d="M2.5 12 12 4.5l9.5 7.5" /><path d="M5 10v9.5h14V10" /><path d="M9.5 19.5v-5h5v5" /></>}
  {name === 'blocks' && <><path d="M3 4h8v5H3zM13 4h8v5h-8zM3 11h5v9H3zM10 11h11v4H10zM10 17h11v3H10z" /></>}
  {name === 'brick' && <><rect x="3" y="4" width="18" height="16" rx="1" /><path d="M3 9.3h18M3 14.7h18M9 4v5.3M15 9.3v5.4M9 14.7V20" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'chev' && <path d="m6 9 6 6 6-6" />}
  {name === 'snow' && <path d="M12 2v20M3.3 7l17.4 10M20.7 7 3.3 17M9 3.5 12 6l3-2.5M9 20.5 12 18l3 2.5M3.6 10.6l3.8-1.2-.9-3.8M20.4 13.4l-3.8 1.2.9 3.8M3.6 13.4l3.8 1.2-.9 3.8M20.4 10.6l-3.8-1.2.9-3.8" />}
  {name === 'drag' && <path d="M9 7 4 12l5 5M15 7l5 5-5 5" />}
</svg>
