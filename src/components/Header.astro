---
import Icon from './Icon.astro';
import { site, nav } from '../data/site';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const on = (h: string) => (h === '/' ? path === '/' || path === '/index' : path === h || path.startsWith(h + '/'));
---
<header class="hdr" data-hdr>
  <div class="container hdr__in">
    <a href="/" class="hdr__logo" aria-label="Templar Transport Ltd — home"><img src="/img/logo.png" alt="Templar Transport Ltd — Temperature Controlled Distribution" width="914" height="84" /></a>
    <nav class="hdr__nav" aria-label="Main">{nav.map((n) => <a href={n.href} aria-current={on(n.href) ? 'page' : undefined}>{n.label}</a>)}</nav>
    <div class="hdr__cta">
      <a class="tel hdr__tel" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
      <a class="btn btn--sm" href="/contact">Get a quote</a>
    </div>
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Menu" data-burger><Icon name="menu" /></button>
  </div>
  <div class="mnav" id="mnav" data-mnav hidden>
    <nav class="container" aria-label="Mobile">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
    <div class="container mnav__cta">
      <a class="btn" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
      <a class="btn btn--navy" href="/contact">Get a quote <Icon name="arrow" /></a>
    </div>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: var(--z-header); background: rgba(255, 255, 255, .97); border-bottom: 3px solid var(--red); transition: transform .4s var(--ease-out), box-shadow .3s; }
  .hdr.is-solid { box-shadow: 0 8px 30px rgba(7, 12, 36, .12); }
  .hdr.is-hidden { transform: translateY(-110%); }
  .hdr__in { display: flex; align-items: center; gap: 1.4rem; height: var(--hdr-h); }
  .hdr__logo { flex-shrink: 1; min-width: 0; }
  .hdr__logo img { width: clamp(210px, 22vw, 300px); height: auto; }
  .hdr__nav { display: none; gap: .1rem; margin-inline: auto; }
  .hdr__nav a { font-family: var(--f-display); font-weight: 700; font-style: italic; text-transform: uppercase; letter-spacing: .03em; font-size: 1rem; text-decoration: none; padding: .5rem .7rem; color: var(--navy); position: relative; }
  .hdr__nav a::after { content: ''; position: absolute; left: .7rem; right: .7rem; bottom: .15rem; height: 2px; background: var(--red); transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease-out); }
  .hdr__nav a:hover::after, .hdr__nav a[aria-current]::after { transform: scaleX(1); }
  .hdr__cta { display: none; align-items: center; gap: 1rem; }
  .hdr__cta .btn { white-space: nowrap; }
  .hdr__tel { color: var(--navy); font-size: 1.2rem; }
  .hdr__tel :global(svg) { color: var(--red); }
  .hdr__burger { margin-left: auto; width: 48px; height: 48px; flex-shrink: 0; display: grid; place-items: center; background: var(--navy); border: 0; border-radius: var(--radius); color: #fff; cursor: pointer; }
  .hdr__burger :global(svg) { width: 24px; height: 24px; }
  .mnav { position: fixed; inset: calc(var(--hdr-h) + 3px) 0 0; background: var(--navy); color: #fff; overflow-y: auto; padding: 1.5rem 0 3rem; z-index: var(--z-menu); }
  .mnav[hidden] { display: none; }
  .mnav nav { display: grid; }
  .mnav nav a { font-family: var(--f-display); font-weight: 800; font-style: italic; text-transform: uppercase; font-size: 2rem; text-decoration: none; padding: .45rem 0; border-bottom: 1px solid var(--line-d); }
  .mnav__cta { display: grid; gap: .7rem; margin-top: 1.6rem; }
  .mnav__cta .btn { justify-content: center; }
  @media (min-width: 1200px) { .hdr__nav, .hdr__cta { display: flex; } .hdr__burger { display: none; } }
  @media (min-width: 760px) and (max-width: 1199px) { .hdr__cta { display: flex; margin-left: auto; } .hdr__burger { margin-left: 0; } }
</style>
