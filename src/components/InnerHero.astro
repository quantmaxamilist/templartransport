---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { label: string; title: string; sub?: string; crumbs?: { href: string; label: string }[] }
const { label, title, sub, crumbs = [] } = Astro.props;
---
<section class="ih stage frostbg">
  <div class="ih__img" aria-hidden="true"><img src="/img/fleet-lineup-sm.webp" alt="" width="900" height="675" /></div>
  <div class="container ih__in">
    <nav class="ih__crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{crumbs.map((c) => <><span>/</span><a href={c.href}>{c.label}</a></>)}</nav>
    <p class="label">{label}</p>
    <h1 set:html={title} />
    {sub && <p class="ih__sub">{sub}</p>}
    <div class="ih__cta"><a class="btn" href="/contact">Get a quote <Icon name="arrow" /></a><a class="btn btn--line" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a></div>
  </div>
</section>
<style>
  .ih { position: relative; overflow: hidden; padding-block: clamp(70px, 10vw, 140px) clamp(48px, 6vw, 80px); }
  .ih__img { position: absolute; inset: 0 0 0 auto; width: min(55%, 760px); opacity: .5; }
  .ih__img img { width: 100%; height: 100%; object-fit: cover; }
  .ih__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--stage) 0%, rgba(7, 12, 36, .4) 60%, rgba(7, 12, 36, .2)); }
  .ih__in { position: relative; display: grid; gap: 1rem; justify-items: start; }
  .ih__crumbs { display: flex; gap: .5rem; flex-wrap: wrap; font-size: .85rem; color: var(--muted-d); }
  .ih__crumbs a { text-decoration: none; }
  .ih__crumbs a:hover { color: #fff; }
  .ih h1 { max-width: 18ch; }
  .ih__sub { max-width: 52ch; color: rgba(255, 255, 255, .88); font-size: clamp(1.05rem, 1.4vw, 1.25rem); }
  .ih__cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .5rem; }
  @media (max-width: 640px) { .ih__img { width: 100%; opacity: .25; } }
</style>
